# Copy to .env.local for local development, and set the same keys in the
# Vercel project settings for production.

# Resend API key (https://resend.com/api-keys). Sending scope only.
RESEND_API_KEY=

# Where website inquiries are delivered.
INQUIRY_TO=nancy@nancydavisexecutivetraining.com

# Verified sender address. Until nancydavisexecutivetraining.com is verified in
# Resend (add the SPF/DKIM records it gives you to Porkbun's DNS), leave this as
# onboarding@resend.dev — Resend will not send from an unverified domain.
INQUIRY_FROM=onboarding@resend.dev
